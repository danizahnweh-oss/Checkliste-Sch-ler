<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interaktive Checkliste: KI reflektiert nutzen</title>
    <style>
        :root {
            --primary: #2c3e50;
            --secondary: #34495e;
            --accent: #3498db;
            --bg: #f4f7f6;
            --card-bg: #ffffff;
            --border: #dcdde1;
            --text: #2f3640;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.6;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        header {
            text-align: center;
            border-bottom: 3px solid var(--primary);
            margin-bottom: 40px;
            padding-bottom: 20px;
        }

        h1 { margin: 0; color: var(--primary); font-size: 2em; }
        h2 { 
            color: var(--accent); 
            font-size: 1.4em; 
            margin-top: 45px; 
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
        }

        .item-card {
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            background: #fff;
        }

        .item-title {
            font-weight: 600;
            font-size: 1.1em;
            display: block;
            margin-bottom: 10px;
        }

        details {
            margin-bottom: 15px;
        }

        details summary {
            font-size: 0.9em;
            color: var(--accent);
            cursor: pointer;
            list-style: none;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        details summary::before {
            content: 'ℹ️';
        }

        .explanation-content {
            background: #f8f9fa;
            padding: 12px;
            border-radius: 6px;
            font-size: 0.95em;
            margin-top: 8px;
            border-left: 3px solid var(--accent);
        }

        /* Smiley Rating System */
        .rating-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fafafa;
            padding: 10px 15px;
            border-radius: 30px;
            margin-top: 15px;
        }

        .smileys {
            display: flex;
            gap: 15px;
        }

        .smileys input {
            display: none;
        }

        .smileys label {
            font-size: 1.6em;
            cursor: pointer;
            transition: all 0.2s ease;
            filter: grayscale(100%);
            opacity: 0.4;
        }

        .smileys input:checked + label {
            filter: grayscale(0%);
            opacity: 1;
            transform: scale(1.3);
        }

        textarea {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 12px;
            margin-top: 15px;
            font-family: inherit;
            resize: vertical;
            min-height: 60px;
            box-sizing: border-box;
        }

        .footer {
            margin-top: 60px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            text-align: center;
        }

        .print-btn {
            background-color: transparent;
            color: #7f8c8d;
            border: 1px solid #7f8c8d;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.9em;
            transition: all 0.3s;
        }

        .print-btn:hover {
            background-color: #7f8c8d;
            color: white;
        }

        @media print {
            body { padding: 0; background: white; }
            .container { box-shadow: none; width: 100%; padding: 0; }
            .print-btn, details summary { display: none; }
            details[open] .explanation-content { display: block; }
            .item-card { break-inside: avoid; border: 1px solid #eee; }
            h2 { page-break-after: avoid; }
        }
    </style>
</head>
